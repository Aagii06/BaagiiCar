JWT_SECRET=car_dealer_jwt_secure

NODE_ENV=development

RECAPTCHA_SECRET_KEY=6Lf9QkUtAAAAALVv1YSn0Yz9EsDsD2mCB0GlvR9C

# Android утсан дээрх SMS gateway app (sms_gateway_app)-ийн token. Утасны OTP үүгээр SMS-ээр очно.
# Хоосон бол утсаар нэвтрэх код нь OTP_DEV_CODE (анхдагч 2222), утас баталгаажуулах болон
# баталгаажуулаагүй бүртгэл устгах ажил унтраалттай.
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SMS_GATEWAY_TOKEN=

# seeders/20261015000002-seed-admin.js
ADMIN_PHONENUMBER=
ADMIN_PASSWORD=

PORT=5011

# Шинэ зарын мэдэгдэл (helper/notifyHelper.js)
# Имэйлийн холбоос болон бүртгэлээс гарах хуудас энэ хаяг руу заана
# Production: WEB_URL=https://cardealer.mn (хоосон бол production-д үүнийг автоматаар авна)
WEB_URL=https://cardealer.mn
# Backend-ийн нийтийн хаяг: имэйл дэх зарын зургийн холбоос (хоосон бол зураггүй илгээнэ)
API_URL=
# Шинэ заруудын имэйл (helper/digestHelper.js): өдөр бүр DIGEST_HOUR цагт шалгаад
# сүүлд илгээснээс хойш DIGEST_INTERVAL_DAYS өдөр өнгөрсөн бол илгээнэ
DIGEST_INTERVAL_DAYS=1
DIGEST_HOUR=10
# Gmail: App password ашиглана (helper/mailHelper.js). Хоосон бол dev орчинд OTP кодыг консолд хэвлэнэ
MAIL_USER_NAME=
MAIL_USER_PASS=
# Push: `npx web-push generate-vapid-keys` -ээр үүсгэнэ
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Улсын / арлын дугаараар машины мэдээлэл татах сервис (web/cars/controller.js).
# Хаяг солигдвол зөвхөн энд солиод backend-ээ restart хийнэ — admin, вэб, апп-ыг дахин build хийх шаардлагагүй.
AUTOBOX_URL=https://www.autobox.mn/api/services/app/Xyp/GetAutoboxInfo
